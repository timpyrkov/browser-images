{
  "manifest_version": 3,
  "name": "Image Downloader for Gallery Tabs",
  "version": "1.0.1",
  "description": "Image downloader from open browser tabs.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "scripting",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Image Downloader for Gallery Tabs",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
}
